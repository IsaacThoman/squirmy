{
  "expo": {
    "name": "Squirmy",
    "slug": "squirmy",
    "scheme": ["squirmy", "tone"],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": { "backgroundColor": "#111014" }
        }
      ],
      "expo-sqlite"
    ],
    "ios": {
      "bundleIdentifier": "com.isaacthoman.music",
      "supportsTablet": true
    },
    "android": {
      "package": "com.isaacthoman.music"
    }
  }
}
