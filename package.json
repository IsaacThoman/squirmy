{
  "name": "squirmy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "npm run dev:api",
    "dev:api": "npm run dev -w @squirmy/server",
    "dev:web": "npm run dev -w @squirmy/web",
    "dev:mobile": "npm run start -w @squirmy/mobile",
    "build:packages": "npm run build -w @squirmy/contracts && npm run build -w @squirmy/client-core",
    "build:adapters": "npm run build -w @squirmy/provider-kit && npm run build -w @squirmy/adapter-mock && npm run build -w @squirmy/adapter-cold-storage",
    "build": "npm run build:packages && npm run build:adapters && npm run build --workspaces --if-present",
    "typecheck": "npm run build:packages && npm run build:adapters && npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && npm run build:adapters && npm run test --workspaces --if-present",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "db:generate": "npm run db:generate -w @squirmy/server",
    "db:migrate": "npm run db:migrate -w @squirmy/server",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/check-doc-anchors.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "oxlint": "^1.94.0",
    "patch-package": "^8.0.1",
    "semantic-release": "^25.0.8",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitepress@1.6.4": {
      "vite": "6.4.3"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "argon2": true,
    "fsevents": true
  }
}
