+// Since iOS 26 UINavigationController can push while a pop is still animating; the pop finishes at once and the push
+// begins. A zoom pop keeps its transition coordinator alive well after the page looks closed, so waiting for it made a
+// tap on the screen underneath feel ignored for most of a second.
+- (BOOL)canPushDuringPop:(NSArray<UIViewController *> *)controllers
+{
+  if (@available(iOS 26.0, *)) {
+    id<UIViewControllerTransitionCoordinator> coordinator = _controller.transitionCoordinator;
+    NSArray<UIViewController *> *current = _controller.viewControllers;
+    UIViewController *from = [coordinator viewControllerForKey:UITransitionContextFromViewControllerKey];
+    // A zoom dismissed by a swipe reports itself as interactive until it settles, even after the finger lifts.
+    BOOL zoom = from.preferredTransition != nil;
+    if (from == nil || [current containsObject:from] || coordinator.isCancelled || (coordinator.isInteractive && !zoom)) {
+      return NO;
+    }
+    // A screen closed by a back swipe stays in the JS state until its pop completes, so drop it here.
+    NSMutableArray<UIViewController *> *pending = [controllers mutableCopy];
+    [pending removeObject:from];
+    // Only a single push on top of the stack the pop is landing on.
+    return pending.count == current.count + 1 &&
+        [[pending subarrayWithRange:NSMakeRange(0, current.count)] isEqualToArray:current];
+  }
+  return NO;
+}
