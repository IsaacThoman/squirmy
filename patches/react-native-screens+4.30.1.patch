+// Squirmy: whether a list has a row slid open to show its swipe actions.
+- (BOOL)showsSwipeActions:(UIView *)view depth:(int)depth
+{
+  for (UIView *subview in view.subviews) {
+    // The row keeps an empty container for its actions; it holds them only while they show.
+    if (!subview.hidden && subview.subviews.count > 0 &&
+        [NSStringFromClass([subview class]) containsString:@"SwipeAction"]) {
+      return YES;
+    }
+    if (depth > 1 && [self showsSwipeActions:subview depth:depth - 1]) {
+      return YES;
+    }
+  }
+  return NO;
+}
