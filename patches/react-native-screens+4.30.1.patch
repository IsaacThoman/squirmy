+// Squirmy: how far in from the edge the system's edge swipe (and a zoomed page's own dismissal) keeps the gesture.
+static const CGFloat RNSBackSwipeEdgeWidth = 24;
+
+// Squirmy: a full screen back swipe moves toward the back more than up or down, starts away from the edge, and
+// does not start over a horizontal scroll view that can still scroll back: that one scrolls first, as in Apple Music.
+- (BOOL)isBackSwipe:(UIPanGestureRecognizer *)gestureRecognizer
+{
+  UIView *view = gestureRecognizer.view;
+  BOOL isRTL = _controller.view.semanticContentAttribute == UISemanticContentAttributeForceRightToLeft;
+  CGPoint translation = [gestureRecognizer translationInView:view];
+  CGPoint location = [gestureRecognizer locationInView:view];
+  // The pan begins past its own small threshold, so a slow drag can arrive with no translation yet: its
+  // velocity tells the direction then.
+  CGPoint direction = hypot(translation.x, translation.y) >= 2 ? translation : [gestureRecognizer velocityInView:view];
+  CGFloat towardBack = isRTL ? -direction.x : direction.x;
+  if (towardBack <= 0 || fabs(direction.y) >= towardBack) {
+    return NO;
+  }
+  CGPoint start = CGPointMake(location.x - translation.x, location.y - translation.y);
+  CGFloat fromEdge = isRTL ? view.bounds.size.width - start.x : start.x;
+  if (fromEdge < RNSBackSwipeEdgeWidth) {
+    return NO;
+  }
+  for (UIView *hit = [view hitTest:start withEvent:nil]; hit != nil && hit != view; hit = hit.superview) {
+    if ([hit isKindOfClass:[UIScrollView class]]) {
+      UIScrollView *scrollView = (UIScrollView *)hit;
+      UIEdgeInsets inset = scrollView.adjustedContentInset;
+      CGFloat maxOffset = scrollView.contentSize.width + inset.right - scrollView.bounds.size.width;
+      BOOL canScrollBack = isRTL ? scrollView.contentOffset.x < maxOffset - 0.5
+                                 : scrollView.contentOffset.x > -inset.left + 0.5;
+      if ([self scrollViewHasHorizontalPart:scrollView] && canScrollBack) {
+        return NO;
+      }
+    }
+  }
+  return YES;
+}
